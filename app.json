{
  "package_id": "com.jichulryu.evenworship",
  "edition": "202601",
  "name": "Even Worship",
  "version": "0.6.2",
  "min_sdk_version": "0.0.14",
  "entrypoint": "index.html",
  "permissions": [
    {
      "name": "network",
      "desc": "Search for permitted music charts, load public score images, and process explicitly requested voice commands.",
      "whitelist": [
        "https://api.tavily.com",
        "https://api.groq.com",
        "https://generativelanguage.googleapis.com",
        "https://jichulryu.github.io",
        "https://blog.kakaocdn.net",
        "https://t1.daumcdn.net",
        "https://hedista.tistory.com",
        "https://www.google.com"
      ]
    },
    {
      "name": "g2-microphone",
      "desc": "Record a short voice command after the user activates search."
    },
    {
      "name": "album",
      "desc": "Select a permitted score image."
    }
  ],
  "supported_languages": [
    "ko"
  ],
  "min_app_version": "2.2.9"
}
